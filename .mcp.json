{
  "mcpServers": {
    "reui": {
      "type": "http",
      "url": "https://mcp.reui.io/api/mcp"
    },
    "convex": {
      "command": "pnpm",
      "args": [
        "--dir",
        "packages/backend",
        "exec",
        "convex",
        "mcp",
        "start"
      ]
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp"
    }
  }
}
