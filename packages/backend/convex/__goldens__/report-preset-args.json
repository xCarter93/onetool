 "projected-income": {
  "entityType": "invoices",
  "config": {
   "version": 2,
   "entityType": "invoices",
   "filters": {
    "logic": "and",
    "groups": [
     {
      "logic": "or",
      "rules": [
       {
        "field": "status",
        "operator": "equals",
