   "groupBy": "completedAt_month"
  }
 },
 "average-invoice-value": {
  "entityType": "invoices",
  "config": {
   "version": 2,
   "entityType": "invoices",
   "metric": {
    "op": "avg",
    "field": "total"
   },
   "groupBy": "issuedDate_month"
  }
 },
 "team-workload": {
